{
  "name": "nestling",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "tsc -b",
    "validate-data": "tsx scripts/validate-data.ts",
    "check-links": "tsx scripts/check-links.ts",
    "fit-labor-model": "tsx scripts/fit-labor-model.ts",
    "fonts": "tsx scripts/fetch-fonts.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "format": "prettier --write .",
    "check-contrast": "tsx scripts/check-contrast.ts",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts tests/e2e/pwa.spec.ts",
    "test:e2e:visual": "playwright test tests/e2e/skins.spec.ts",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.33.5",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-declaration-strict-value": "^1.12.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9"
  }
}
